# ============================================================
# QRIS Payment Gateway Platform - Environment Configuration
# ============================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth & PostgreSQL
# Direct PostgreSQL connection pooler (e.g. Supabase Session/Transaction Pooler)
DATABASE_URL=postgresql://postgres.yhdampyqswtizzhrfvxm:[YOUR_PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://yhdampyqswtizzhrfvxm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# GoBiz Merchant Adapter
GOBIZ_API_BASE_URL=https://api.gobiz.co.id
GOBIZ_CLIENT_ID=go-biz-web-new
USE_MOCK_GOBIZ=true

# AES-256-GCM Token Encryption (Must be 32 bytes = 64 hex characters or 32 raw chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Webhook & Cron Security
WEBHOOK_SIGNING_SECRET=whsec_your_default_signing_secret_here
CRON_SECRET=super_secret_cron_token_for_scheduled_sync

# QRIS Payment Provider
# Options: 'sandbox' or official provider identifier ('midtrans', 'doku', 'xendit')
QRIS_PROVIDER=sandbox
QRIS_PROVIDER_BASE_URL=https://api.sandbox.midtrans.com
QRIS_PROVIDER_API_KEY=SB-Mid-server-xxxxxxxxxxxx

# Transaction Provider Source
TRANSACTION_PROVIDER=gobiz_analytics
